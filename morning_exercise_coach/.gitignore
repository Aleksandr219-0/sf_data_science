__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Игнорируем только тяжелые веса моделей и промежуточные массивы
models/*.task
data/processed/*.npy

# Разрешаем структуры папок
!data/original/.gitkeep
!data/reference/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!output/.gitkeep

# Разрешаем исходные видео и итоговые результаты для сдачи диплома
!data/original/*.mp4
!data/reference/*.mp4
!output/morning_coach_result.mp4
!output/morning_coach_metrics.csv
!output/metrics_plot.png